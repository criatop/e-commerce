		{
			"name": "Flujo Completo (E2E)",
			"description": "Ejecutar estos requests en orden para probar el flujo completo de compra. Los valores se auto-asignan via scripts.",
			"item": [
				{
					"name": "1/7 - Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"maria@chic.cl\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.datos && json.datos.token) {",
									"    pm.environment.set('token', json.datos.token);",
									"    pm.environment.set('userId', json.datos.email);",
									"    console.log('Token set. User: ' + json.datos.email);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "2/7 - Get Products",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/products",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.datos && json.datos.length > 0) {",
									"    pm.environment.set('productId', json.datos[0].id);",
									"    pm.environment.set('productName', json.datos[0].name);",
									"    pm.environment.set('productPrice', json.datos[0].price);",
									"    console.log('Product set: ' + json.datos[0].name + ' (SKU: ' + json.datos[0].sku + ')');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "3/7 - Add to Cart",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/cart/{{userId}}/items",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "{{userId}}", "items"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"console.log('Cart total: ' + (json.datos ? json.datos.totalAmount : 'N/A'));"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "4/7 - Create Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"shippingAddress\": \"Av. Providencia 1234, Santiago\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/orders",
							"host": ["{{baseUrl}}"],
							"path": ["api", "orders"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.datos && json.datos.id) {",
									"    pm.environment.set('orderId', json.datos.id);",
									"    console.log('Order created: ' + json.datos.id + ' Status: ' + json.datos.status);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "5/7 - Process Payment (triggers Feign PENDING->PAID + Kafka events)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"userId\": \"{{userId}}\",\n  \"amount\": 39980,\n  \"method\": \"CREDIT_CARD\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/payments",
							"host": ["{{baseUrl}}"],
							"path": ["api", "payments"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"console.log('Payment processed: ' + (json.datos ? json.datos.status : 'N/A'));",
									"console.log('Feign: Payment -> Order update to PAID');",
									"console.log('Kafka: payment.completed -> notification, analytics, shipping');"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "6/7 - Create Shipment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"userId\": \"{{userId}}\",\n  \"address\": \"Av. Providencia 1234\",\n  \"city\": \"Santiago\",\n  \"postalCode\": \"7500000\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/shipping",
							"host": ["{{baseUrl}}"],
							"path": ["api", "shipping"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.datos) {",
									"    pm.environment.set('trackingNumber', json.datos.trackingNumber);",
									"    console.log('Tracking: ' + json.datos.trackingNumber);",
									"    console.log('Carrier: ' + json.datos.carrier);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "7/7 - Dejar Review",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"userId\": \"{{userId}}\",\n  \"rating\": 5,\n  \"comment\": \"Comprueba todo el flujo E2E - Excelente!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/reviews",
							"host": ["{{baseUrl}}"],
							"path": ["api", "reviews"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"console.log('=== E2E Flow Complete! ===');",
									"console.log('Services involved:');",
									"console.log('  Auth -> register/login (JWT)');",
									"console.log('  Product -> catalog query');",
									"console.log('  Cart -> add items');",
									"console.log('  Order -> create (Feign: Product, Inventory) + Kafka: order.created');",
									"console.log('  Payment -> process (Feign: Order PENDING->PAID) + Kafka: payment.completed');",
									"console.log('  Shipping -> create (auto via Kafka or manual)');",
									"console.log('  Review -> create');",
									"console.log('  Notification -> email confirmations (Kafka consumer)');",
									"console.log('  Analytics -> sales/user data (Kafka consumer)');",
									"console.log('  Inventory -> stock management (Kafka consumer)');"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		}
	]
}
