					}
				},
				{
					"name": "Update Cart Quantity",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/cart/{{userId}}/items/{{productId}}?quantity=3",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "{{userId}}", "items", "{{productId}}"],
							"query": [
								{
									"key": "quantity",
									"value": "3"
								}
							]
						}
					}
				},
				{
					"name": "Remove from Cart",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/cart/{{userId}}/items/{{productId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "{{userId}}", "items", "{{productId}}"]
						}
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/cart/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "{{userId}}"]
						}
					}
				}
			]
		},
