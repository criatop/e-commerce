						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/cart/{{userId}}/items",
							"host": ["{{baseUrl}}"],
							"path": ["api", "cart", "{{userId}}", "items"]
