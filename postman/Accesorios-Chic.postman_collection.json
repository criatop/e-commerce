{
  "info": {
    "name": "Accesorios Chic - API v1",
    "description": "Coleccion de la API del e-commerce. Todas las peticiones pasan por el API Gateway (http://localhost:9000). La carpeta 'Auth' guarda el JWT en la variable {{token}} al hacer login; el resto usa Authorization: Bearer {{token}}. Variables de la coleccion: baseUrl, token, uid, productId, categoryId, folio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9000" },
    { "key": "token", "value": "" },
    { "key": "uid", "value": "3" },
    { "key": "productId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "folio", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (guarda JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.exitoso && res.datos && res.datos.token) {",
                  "  pm.collectionVariables.set('token', res.datos.token);",
                  "  pm.collectionVariables.set('uid', String(res.datos.usuario.id));",
                  "  console.log('Token guardado para ' + res.datos.usuario.email + ' (' + res.datos.rol + ')');",
                  "} else {",
                  "  throw new Error('Login fallido: ' + (res.mensaje || JSON.stringify(res)));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"camila@gmail.com\",\n  \"password\": \"cliente1\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Registro cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run\": \"555555555\",\n  \"email\": \"nuevo@gmail.com\",\n  \"password\": \"123456\",\n  \"nombre\": \"Nuevo\",\n  \"apellidos\": \"Cliente\",\n  \"fechaNacimiento\": \"2000-01-01\",\n  \"regionId\": 1,\n  \"comunaId\": 1,\n  \"direccion\": \"Av. Siempre Viva 123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Perfil actual (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Actualizar perfil (/me)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"direccion\": \"Av. Nueva 456\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Crear ADMIN/SELLER (solo ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"run\": \"666666666\",\n  \"email\": \"vendedor2@gmail.com\",\n  \"password\": \"123456\",\n  \"nombre\": \"Vendedor\",\n  \"apellidos\": \"Nuevo\",\n  \"rol\": \"SELLER\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/admin/register"
          }
        }
      ]
    },
    {
      "name": "Maestras y usuarios",
      "item": [
        { "name": "Regiones", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/regions" } },
        { "name": "Comunas", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/comunas" } },
        { "name": "Roles", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/roles" } },
        { "name": "Listar usuarios (ADMIN)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users" } },
        { "name": "Obtener usuario (ADMIN)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/users/{{uid}}" } }
      ]
    },
    {
      "name": "Catalogo",
      "item": [
        { "name": "Listar productos", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products" } },
        { "name": "Buscar productos", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/search?q=collar" } },
        { "name": "Productos por categoria", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/category/{{categoryId}}" } },
        {
          "name": "Detalle de producto (guarda productId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.exitoso && res.datos && res.datos.id) pm.collectionVariables.set('productId', res.datos.id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/products/{{productId}}" }
        },
        {
          "name": "Precios por lote",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"ids\": [\"{{productId}}\"]\n}" },
            "url": "{{baseUrl}}/api/v1/products/batch"
          }
        },
        { "name": "Listar categorias", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" } },
        { "name": "Detalle categoria", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}" } },
        {
          "name": "Crear categoria (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nueva categoria\",\n  \"description\": \"Descripcion\",\n  \"activa\": true\n}" },
            "url": "{{baseUrl}}/api/v1/categories"
          }
        },
        {
          "name": "Actualizar categoria (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoria editada\",\n  \"description\": \"Nueva descripcion\",\n  \"activa\": true\n}" },
            "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}"
          }
        },
        {
          "name": "Eliminar categoria (ADMIN)",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/categories/{{categoryId}}" }
        },
        {
          "name": "Crear producto (ADMIN/SELLER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"PRU-001\",\n  \"name\": \"Producto de prueba\",\n  \"description\": \"Descripcion\",\n  \"price\": 19990,\n  \"category\": \"{{categoryId}}\",\n  \"imageUrl\": \"https://example.com/img.jpg\",\n  \"active\": true,\n  \"stockQuantity\": 20,\n  \"lowStockThreshold\": 5\n}" },
            "url": "{{baseUrl}}/api/v1/products"
          }
        }
      ]
    },
    {
      "name": "Favoritos",
      "item": [
        { "name": "Listar favoritos", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/favorites" } },
        { "name": "Alternar favorito", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/favorites/{{productId}}" } },
        { "name": "Quitar favorito", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/favorites/{{productId}}" } }
      ]
    },
    {
      "name": "Carrito",
      "item": [
        { "name": "Obtener carrito", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/cart/{{uid}}" } },
        {
          "name": "Agregar item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/api/v1/cart/{{uid}}/items"
          }
        },
        {
          "name": "Actualizar cantidad",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/v1/cart/{{uid}}/items/{{productId}}?quantity=3"
          }
        },
        {
          "name": "Fusionar carrito anonimo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "[\n  { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n]" },
            "url": "{{baseUrl}}/api/v1/cart/{{uid}}/merge"
          }
        },
        { "name": "Quitar item", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/cart/{{uid}}/items/{{productId}}" } },
        { "name": "Vaciar carrito", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/cart/{{uid}}" } }
      ]
    },
    {
      "name": "Checkout y ordenes",
      "item": [
        {
          "name": "Checkout orquestado (guarda folio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.exitoso && res.datos && res.datos.folio) pm.collectionVariables.set('folio', res.datos.folio);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": \"Los Aromos 789\",\n  \"shippingRegion\": \"Metropolitana\",\n  \"shippingComuna\": \"Providencia\",\n  \"shippingPhone\": \"+56912345678\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/checkout"
          }
        },
        { "name": "Mis ordenes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/orders/user/{{uid}}" } },
        { "name": "Detalle orden por folio/id", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/orders/{{folio}}" } },
        { "name": "Todas las ordenes (ADMIN/SELLER)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/orders" } },
        { "name": "Estadisticas (ADMIN/SELLER)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/orders/stats" } },
        {
          "name": "Cancelar orden",
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/orders/{{folio}}/cancel" }
        }
      ]
    },
    {
      "name": "Pagos y envios",
      "item": [
        {
          "name": "Crear pago (idempotente por orderId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{folio}}\",\n  \"userId\": \"{{uid}}\",\n  \"amount\": 19990,\n  \"method\": \"CREDIT_CARD\"\n}" },
            "url": "{{baseUrl}}/api/payments"
          }
        },
        { "name": "Pago de una orden", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/payments/order/{{folio}}" } },
        {
          "name": "Crear envio (idempotente por orderId)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{folio}}\",\n  \"userId\": \"{{uid}}\",\n  \"address\": \"Los Aromos 789\",\n  \"city\": \"Providencia\",\n  \"postalCode\": \"7500000\",\n  \"region\": \"Metropolitana\",\n  \"comuna\": \"Providencia\"\n}" },
            "url": "{{baseUrl}}/api/shipping"
          }
        },
        { "name": "Envio de una orden", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/shipping/user/{{uid}}" } }
      ]
    },
    {
      "name": "Contenido",
      "item": [
        { "name": "Noticias", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/news?page=0&size=10" } },
        { "name": "Detalle noticia", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/news/algun-slug" } },
        {
          "name": "Enviar mensaje de contacto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Camila\",\n  \"apellido\": \"Rosales\",\n  \"email\": \"camila@gmail.com\",\n  \"mensaje\": \"Consulta sobre un producto\"\n}" },
            "url": "{{baseUrl}}/api/v1/contact"
          }
        },
        { "name": "Listar mensajes (ADMIN)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/v1/contact" } }
      ]
    },
    {
      "name": "Salud",
      "item": [
        { "name": "Health Gateway", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" } },
        { "name": "Health Auth", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/actuator/health" } }
      ]
    }
  ]
}
